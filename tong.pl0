program TinhTong ;

const max = 100;    // Dinh nghia hang so max = 100
var sum, i, n;    // Khai bao bien sum, i, n 

/* (Day la phan chu thich nhieu dong)
    Nhom gom 4 thanh vien:
    
    Nguyen Ba Anh - 20215260
    Nguyen Hung Cuong - 20215264
    Tran Quoc Duy - 20207643
    Hoang Nguyen Truong Giang - 20215270
*/  

procedure computeSum;
begin
    sum := 0;    // Khoi tao tong bang 0
    i := 1;      // Bien dem i bat dau tu 1
    
    while i <= n do
    begin
        sum := sum + i;  // Cong i vao tong
        i := i + 1;      // Tang i len 1
    end
end;

begin
    n := 10;  // Gan n = 10 (tinh tong tu 1 den 10)
    call computeSum;  // Goi thu tuc computeSum
end.